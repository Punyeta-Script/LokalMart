# Local development: copy to .env and export these, or set them in the Vercel dashboard.

# Supabase: click "Connect" in your project, choose "Transaction pooler" (port 6543) and copy the URI.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# REQUIRED in production: a long random string
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
NODE_ENV=production

# First-run admin account (only used when the database is empty)
ADMIN_EMAIL=admin@lokalmart.ph
ADMIN_PASSWORD=change-this-password

# true = create demo sellers/products/buyer on first run, false = start empty
SEED_DEMO=false

# --- Optional features (each one switches on only when its variables are set) ---

# Password reset by email (resend.com). Without a verified domain, Resend only delivers to your own email.
RESEND_API_KEY=
MAIL_FROM=LokalMart <noreply@your-domain.com>

# Product photos in Supabase Storage: Project Settings > API > Project URL and the service_role key (keep it secret!)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images

# Push notifications: run `npm run vapid` once and paste the keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Online payments with Xendit (GCash, Maya, cards): dashboard > Settings > API keys
XENDIT_SECRET_KEY=
# Settings > Callbacks: set the "Invoices paid" and "Invoices expired" URLs to https://YOUR-APP.vercel.app/api/xendit/callback
# and copy the callback verification token here:
XENDIT_CALLBACK_TOKEN=
# optional: limit methods, e.g. GCASH,PAYMAYA,CREDIT_CARD (empty = all methods enabled in your dashboard)
XENDIT_METHODS=
# optional: your public site URL, used for the payment return links
APP_URL=

# Realtime updates (Supabase Realtime Broadcast): Project Settings > API > anon public key.
# Also needs SUPABASE_URL and SUPABASE_SERVICE_KEY above.
SUPABASE_ANON_KEY=
