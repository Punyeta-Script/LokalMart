{
  "name": "lokalmart",
  "version": "1.0.0",
  "description": "LokalMart - mobile-friendly multi-vendor marketplace (Node.js, Express, Supabase Postgres, Vercel)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node server/test.js",
    "schema": "node -e \"process.env.DATABASE_URL='postgres://x@localhost/x';require('fs').writeFileSync('supabase/schema.sql',require('./server/db').SCHEMA)\"",
    "migrate:images": "node scripts/migrate-images.js",
    "vapid": "web-push generate-vapid-keys"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  }
}
