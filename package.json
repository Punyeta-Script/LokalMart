{
  "name": "lokalmart",
  "version": "1.0.0",
  "description": "LokalMart - mobile-friendly multi-vendor marketplace (Node.js, Express, Supabase Postgres, Vercel)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node server/test.js",
    "schema": "node -e \"process.env.DATABASE_URL='postgres://x@localhost/x';require('fs').writeFileSync('supabase/schema.sql',require('./server/db').SCHEMA)\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}